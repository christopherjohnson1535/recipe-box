{
  "name": "recipe-box-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for Recipe Box (Playwright, TypeScript). See README in this folder.",
  "scripts": {
    "test": "playwright test",
    "test:compose": "E2E_STACK=compose playwright test",
    "test:backup": "playwright test -c playwright.backup.config.ts",
    "test:backup:compose": "E2E_STACK=compose playwright test -c playwright.backup.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
