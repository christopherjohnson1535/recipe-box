# Normalise line endings: LF in the repo and in working trees, also on Windows checkouts (shell scripts and
# Dockerfiles break with CRLF).
* text=auto eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary

# Generated files: collapsed in PR diffs and excluded from language stats.
docs/openapi.json linguist-generated=true
frontend/src/lib/api-types.ts linguist-generated=true
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
