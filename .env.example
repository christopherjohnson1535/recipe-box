# Copy to .env and edit. Never commit .env.

# --- database ---
POSTGRES_USER=recipes
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=recipes

# --- web ---
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other devices on your network (iPad).
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- https profile (docker compose --profile https up -d) ---
# A DNS name pointing at this host, ports 80 and 443 open. Set COOKIE_SECURE=true with it.
PUBLIC_HOSTNAME=
COOKIE_SECURE=false

# --- sessions ---
SESSION_DAYS=30

# --- photo / AI import (optional; the app works without it) ---
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- limits / logs ---
MAX_UPLOAD_MB=15
RUST_LOG=info

# --- prebuilt images (deploy/compose.prod.yml) ---
IMAGE_TAG=latest
